# COMPETITION account -- brand new, $100,000 default, never used for dev.
# The account_number from GET /v2/account goes in ACCOUNT_ID.txt (committed).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# DEV account -- throwaway. All prototyping and the live round-trip test.
ALPACA_DEV_API_KEY=
ALPACA_DEV_SECRET_KEY=

# The brain: GLM-5 on Amazon Bedrock, which is what the judged run uses.
# Blackout parsing, regime multiplier, structure veto -- advisory only, and it
# fails closed. Absent entirely = degraded, which still trades at half size.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
CONTOUR_LLM=bedrock

# No-card fallback. Free tier, and the reason the provider seam exists.
GEMINI_API_KEY=

# Non-load-bearing desk note. Deletable without touching anything else.
FEATHERLESS_API_KEY=
